rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Admins or owner check
    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // User profile access
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // Admins collection
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Farms collection
    match /farms/{farmId} {
      allow read: if true; // Allows public lookup of registered farm info for traceability
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Ponds collection
    match /ponds/{pondId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Cycles collection
    match /cycles/{cycleId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Water logs
    match /water_logs/{logId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Feeding logs
    match /feeding_logs/{logId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Disease events
    match /disease_events/{eventId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Treatments
    match /treatments/{treatmentId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Post Larvae lots (PL-)
    match /pl_lots/{lotId} {
      allow read: if true; // Public traceability
      allow write: if isSignedIn();
    }

    // Harvest lots (HV-)
    match /harvest_lots/{lotId} {
      allow read: if true; // Public traceability
      allow write: if isSignedIn();
    }

    // Processing lots (PR-)
    match /processing_lots/{lotId} {
      allow read: if true; // Public traceability
      allow write: if isSignedIn();
    }

    // Export lots (EX-)
    match /export_lots/{lotId} {
      allow read: if true; // Public traceability
      allow write: if isSignedIn();
    }

    // Audit logs (Append only for signed in users)
    match /audit_logs/{auditId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit log
    }

    // Biosecurity & Sanitation logs
    match /biosecurity_logs/{logId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // System configurations & standards (Water, Feeding, Drugs, Diseases)
    match /standards_config/{configId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Farm invites & User Consents
    match /farm_invites/{inviteId} {
      allow read, write: if isSignedIn();
    }

    match /user_consents/{consentId} {
      allow read, write: if isSignedIn();
    }

    // Test connection doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
